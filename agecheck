SELECT
    ROW_NUMBER() OVER (
        ORDER BY
            CASE c.CASENUM
                WHEN 4568 THEN 1
                WHEN 4648 THEN 2
                WHEN 4671 THEN 3
                WHEN 4713 THEN 4
                WHEN 4732 THEN 5
                WHEN 4733 THEN 6
                WHEN 4734 THEN 7
                WHEN 4735 THEN 8
                WHEN 4736 THEN 9
