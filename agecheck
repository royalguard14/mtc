SELECT
    case_number,
    date_filed,
    CASE
        WHEN date_filed > DATE('now', '-1 year')
            THEN 'Less than 1 year'
        WHEN date_filed > DATE('now', '-2 years')
            THEN '1 year to less than 2 years'
        WHEN date_filed > DATE('now', '-3 years')
            THEN '2 years to less than 3 years'
        WHEN date_filed > DATE('now', '-4 years')
            THEN '3 years to less than 4 years'
        WHEN date_filed > DATE('now', '-5 years')
            THEN '4 years to less than 5 years'
        WHEN date_filed > DATE('now', '-6 years')
            THEN '5 years to less than 6 years'
        WHEN date_filed > DATE('now', '-7 years')
            THEN '6 years to less than 7 years'
        WHEN date_filed > DATE('now', '-8 years')
            THEN '7 years to less than 8 years'
        WHEN date_filed > DATE('now', '-9 years')
            THEN '8 years to less than 9 years'
        WHEN date_filed > DATE('now', '-10 years')
            THEN '9 years to less than 10 years'
        ELSE '10 years or more'
    END AS age_bracket
FROM cases
WHERE case_number IN (
    '770',
    '768',
    '769',
    '767',
    '758',
    '761',
    '764',
    '766',
    'SC-225-072126'
)
ORDER BY date_filed;





SELECT
    CASENUM,
    CASETITLE,
    NATUREREM,
    DTFILED,

    CASE
        WHEN NATURECODE = '00027' THEN 1
        WHEN NATURECODE = '00028' THEN 2
        WHEN NATURECODE = '00029' THEN 3
        WHEN NATURECODE = '00030' THEN 4
        WHEN NATURECODE = '00031' THEN 5
        WHEN NATURECODE = '00032' THEN 6
        WHEN NATURECODE = '00033' THEN 7
        WHEN NATURECODE = '00034' THEN 8
        WHEN NATURECODE = '00035' THEN 9
        WHEN NATURECODE = '00036' THEN 10
        ELSE NULL
    END AS ID,

    CASE
        WHEN DTFILED > DATE('now', '-1 year')
            THEN 'Less than 1 year'

        WHEN DTFILED > DATE('now', '-2 years')
            THEN '1 year to less than 2 years'

        WHEN DTFILED > DATE('now', '-3 years')
            THEN '2 years to less than 3 years'

        WHEN DTFILED > DATE('now', '-4 years')
            THEN '3 years to less than 4 years'

        WHEN DTFILED > DATE('now', '-5 years')
            THEN '4 years to less than 5 years'

        WHEN DTFILED > DATE('now', '-6 years')
            THEN '5 years to less than 6 years'

        WHEN DTFILED > DATE('now', '-7 years')
            THEN '6 years to less than 7 years'

        WHEN DTFILED > DATE('now', '-8 years')
            THEN '7 years to less than 8 years'

        WHEN DTFILED > DATE('now', '-9 years')
            THEN '8 years to less than 9 years'

        WHEN DTFILED > DATE('now', '-10 years')
            THEN '9 years to less than 10 years'

        ELSE '10 years or more'
    END AS AGE

FROM ctms1000
WHERE CASENUM IN (

4757,
4758,
4761,
4756,
4749,
4737,
4746,
4674
);


















SELECT
    ROW_NUMBER() OVER (
        ORDER BY CASE c.CASENUM
            WHEN 4754 THEN 1
            WHEN 4756 THEN 2
            WHEN 4752 THEN 3
            WHEN 4749 THEN 4
            WHEN 4737 THEN 5
            WHEN 4746 THEN 6
            WHEN 4674 THEN 7
            WHEN 4693 THEN 8
            WHEN 4715 THEN 9
            WHEN 4716 THEN 10
            WHEN 4717 THEN 11
            WHEN 4718 THEN 12
            WHEN 4719 THEN 13
            WHEN 4720 THEN 14
            WHEN 4721 THEN 15
            WHEN 4722 THEN 16
            WHEN 4723 THEN 17
            WHEN 4724 THEN 18
            WHEN 4725 THEN 19
            WHEN 4726 THEN 20
        END
    ) AS "No.",

    c.CASENUM AS "Case Number",
    c.CASETITLE AS "Title",
    c.NATUREREM AS "Nature",
    c.DTFILED AS "Date Filed",

    'N/A' AS "Date Raffled",

    GROUP_CONCAT(
        DISTINCT
        (
            COALESCE(p.DTARRAIGN,'') ||
            CASE p.PLEA
                WHEN 2 THEN ' - GUILTY'
                WHEN 1 THEN ' - NOT GUILTY'
                ELSE ''
            END
        )
    ) AS "Date of Arraignment",

    GROUP_CONCAT(DISTINCT p.DTPRETRIAL) AS "Date of Pre-trial",

    'N/A' AS "Date of Initial Trial",
    'N/A' AS "Court Action Taken and Date Thereof",
    'N/A' AS "Date Submitted for Decision",
    'HON. SAIDAMEN M. GANIA' AS "Judge to Whom Case is Assigned"

FROM ctms1000 c

LEFT JOIN ctms4100 p
    ON c.CASEID = p.CASEID

WHERE c.CASENUM IN (
4754,
4756,
4752,
4749,
4737,
4746,
4674,
4693,
4715,
4716,
4717,
4718,
4719,
4720,
4721,
4722,
4723,
4724,
4725,
4726
)

GROUP BY
    c.CASEID,
    c.CASENUM,
    c.CASETITLE,
    c.NATUREREM,
    c.DTFILED

ORDER BY
    CASE c.CASENUM
        WHEN 4754 THEN 1
