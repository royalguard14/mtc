                WHEN 4738 THEN 11
                WHEN 4739 THEN 12
                WHEN 4740 THEN 13
                WHEN 4741 THEN 14
                WHEN 4742 THEN 15
                WHEN 4743 THEN 16
                WHEN 4744 THEN 17
                WHEN 4745 THEN 18
                WHEN 4747 THEN 19
                WHEN 4748 THEN 20
                WHEN 4750 THEN 21
                WHEN 4751 THEN 22
                WHEN 4753 THEN 23
                WHEN 4755 THEN 24
            END
    ) AS "No.",

    c.CASENUM AS "Case Number",
    c.CASETITLE AS "Title",
    c.NATUREREM AS "Nature",
    c.DTFILED AS "Date Filed",

    'N/A' AS "Date Raffled",
    
GROUP_CONCAT(
    CASE
        WHEN p.DTARRAIGN IS NULL OR TRIM(p.DTARRAIGN) = '' THEN NULL

        WHEN p.PLEA IS NULL OR p.PLEA = '' THEN
            p.DTARRAIGN

        ELSE
            p.DTARRAIGN ||
            CHAR(10) ||
            '(' ||
            TRIM(
                COALESCE(per.FNAME,'') || ' ' ||
                COALESCE(per.LNAME,'')
            ) ||
            ' - ' ||
            CASE p.PLEA
                WHEN 2 THEN 'GUILTY'
                WHEN 1 THEN 'NOT GUILTY'
            END ||
            ')'
    END,
    CHAR(10) || CHAR(10)
) AS "Date of Arraignment",

    GROUP_CONCAT(DISTINCT p.DTPRETRIAL) AS "Date of Pre-trial",

    'N/A' AS "Date of Initial Trial",
   
   
   CASE
    WHEN p.DTPROMUL IS NULL OR TRIM(p.DTPROMUL) = '' THEN 'N/A'

    ELSE
        CASE p.DECIDECODE
            WHEN '90002' THEN 'DECIDED'
            WHEN '90003' THEN 'DISMISSED'
            ELSE ''
        END
        ||

        CASE
            WHEN p.REMARKS IS NOT NULL
                 AND TRIM(p.REMARKS) <> ''
                 AND INSTR(p.REMARKS, ':') > 0
            THEN
                ' - ' ||
                SUBSTR(
                    p.REMARKS,
                    1,
                    INSTR(p.REMARKS, ':')
                )
            ELSE ''
        END

        ||

        ' - ' || p.DTPROMUL
END AS "Court Action Taken and Date Thereof",
   
   
   
   
   
   
   
   
   
COALESCE(
    GROUP_CONCAT(
        DISTINCT CASE
            WHEN p.DTSUBMIT IS NOT NULL
                 AND TRIM(p.DTSUBMIT) <> ''
            THEN p.DTSUBMIT
        END
    ),
    'N/A'
) AS "Date Submitted for Decision",





    'HON. SAIDAMEN M. GANIA' AS "Judge to Whom Case is Assigned"

FROM ctms1000 c

LEFT JOIN ctms4100 p
